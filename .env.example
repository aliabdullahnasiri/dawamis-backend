# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────

APP_NAME=DawaMIS API
APP_DESCRIPTION=Backend API for DawaMIS pharmacy management system.
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true

EDITION=online


# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────

DATABASE_URL=mysql+asyncmy://USERNAME:PASSWORD@localhost:3306/DATABASE_NAME


# ─────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────

REDIS_URL=redis://localhost:6379/0


# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────

JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30


# ─────────────────────────────────────────────
# Application Secret
# ─────────────────────────────────────────────

SECRET_KEY=your-application-secret-key


# ─────────────────────────────────────────────
# Timezone
# ─────────────────────────────────────────────

TIMEZONE=Asia/Kabul


# ─────────────────────────────────────────────
# SMTP / Mail
# ─────────────────────────────────────────────

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Dawamis


# ─────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────

FRONTEND_URL=http://localhost:5173


# ─────────────────────────────────────────────
# Authentication Rate Limiting
# ─────────────────────────────────────────────

# Maximum failed authentication attempts per IP
AUTH_RATE_LIMIT_IP=10

# IP rate-limit window in seconds (5 minutes)
AUTH_RATE_LIMIT_IP_WINDOW=300

# Maximum failed authentication attempts per user
AUTH_RATE_LIMIT_USER=5

# User rate-limit window in seconds (15 minutes)
AUTH_RATE_LIMIT_USER_WINDOW=900
