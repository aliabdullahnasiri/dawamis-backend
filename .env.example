APP_NAME=DawaMIS API
APP_DESCRIPTION=Backend API for DawaMIS pharmacy management system.
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true

EDITION=online

DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/db_name
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

SECRET_KEY=your_secret_key_here

TIMEZONE=Asia/Kabul

SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

MAIL_FROM_EMAIL=no-reply@dawamis.com
MAIL_FROM_NAME=Dawamis

FRONTEND_URL=http://localhost:5173
